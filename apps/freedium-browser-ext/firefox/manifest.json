{
  "manifest_version": 3,
  "name": "Freedium",
  "version": "0.1.0",
  "description": "Open the current page on freedium-mirror.cfd.",
  "browser_specific_settings": {
    "gecko": {
      "id": "freedium-browser-ext@kanthi.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open this page on Freedium",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-on-freedium": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "MacCtrl+Shift+F"
      },
      "description": "Open the current page on Freedium"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
