# Tanix on Hyprland: a ready-made setup instead of Hyprland's bare default.
#
#   - Tanix hyprland.conf: keys, gaps, animations, Tanix border colours
#   - Waybar in Tanix colours
#   - hyprlock (lock screen with the Tanix wallpaper) and hypridle
#   - mako notifications, cliphist clipboard history, grim/slurp screenshots
#
# Hyprland, Waybar and mako read their settings from the user's home folder.
# A small user service copies the Tanix defaults there at login, but only
# where the user has no file yet, so later edits are never overwritten.
# Hyprland's own generated placeholder config is replaced, since Hyprland
# writes it when it starts before the copy.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  enabled = config.tanix.branding.enable && config.programs.hyprland.enable;
  assets = ./assets/hyprland;

  hyprlockConf = pkgs.replaceVars "${assets}/hyprlock.conf" {
    wallpaper = config.tanix.branding.wallpaperPath;
  };

  # target (relative to ~/.config) -> source file
  defaults = {
    "hypr/hyprland.conf" = "${assets}/hyprland.conf";
    "hypr/hypridle.conf" = "${assets}/hypridle.conf";
    "hypr/hyprlock.conf" = hyprlockConf;
    "waybar/config.jsonc" = "${assets}/waybar.jsonc";
    "waybar/style.css" = "${assets}/waybar.css";
    "mako/config" = "${assets}/mako.conf";
  };

  seed = pkgs.writeShellScript "tanix-hyprland-defaults" ''
    conf="''${XDG_CONFIG_HOME:-$HOME/.config}"
    ${lib.concatStrings (
      lib.mapAttrsToList (target: source: ''
        t="$conf/${target}"
        if [ ! -e "$t" ] || grep -q '^autogenerated = 1' "$t" 2>/dev/null; then
          mkdir -p "$(dirname "$t")"
          install -m 644 ${source} "$t"
        fi
      '') defaults
    )}
  '';
in
{
  config = lib.mkIf enabled {
    programs.hyprlock.enable = true;
    services.hypridle.enable = true;

    environment.systemPackages = with pkgs; [
      waybar
      mako
      cliphist
      wl-clipboard
      fuzzel
      grim
      slurp
      brightnessctl
    ];

    fonts.packages = [ pkgs.dejavu_fonts ];

    systemd.user.services.tanix-hyprland-defaults = {
      description = "Copy the Tanix Hyprland defaults into ~/.config";
      wantedBy = [ "default.target" ];
      before = [ "graphical-session-pre.target" ];
      path = [ pkgs.coreutils pkgs.gnugrep ];
      serviceConfig = {
        Type = "oneshot";
        ExecStart = seed;
      };
    };
  };
}
